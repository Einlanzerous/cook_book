generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id          String       @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  servings    Int?
  prepTime    Int?         // minutes
  cookTime    Int?         // minutes
  source      String       @default("manual") // stored as written; read case-insensitively. 'manual' = no source label
  sourceUrl   String?
  contributorId String?
  contributor Contributor? @relation(fields: [contributorId], references: [id], onDelete: Restrict)
  category    String?
  cuisine     String?
  vegetarian  Boolean      @default(false)
  totalMinutes Int?
  timeSplitEstimated Boolean @default(false)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ingredients Ingredient[]
  directions  Direction[]
  tags        Tag[]        @relation("RecipeTags")

  @@index([contributorId])
  @@index([totalMinutes])
  // Raw index, not expressible here (shows as drift in migrate dev): CREATE INDEX "Recipe_lower_source_idx" ON "Recipe"(lower("source"))
}

model Contributor {
  id          String   @id @default(uuid())
  name        String   // unique on lower(name): raw index "Contributor_lower_name_key", not expressible here
  bio         String?
  portraitUrl String?
  email       String?  @unique
  externalId  String?  @unique
  joinedAt    DateTime @default(now()) @db.Timestamptz(3)
  recipes     Recipe[]
  sessions    Session[]
}

// COOK-23: a signed-in browser. `id` is the sha256 hex of the cookie token (the
// token itself is never stored). Fixed life from mint; revoke by setting revokedAt.
model Session {
  id            String      @id
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime    @db.Timestamptz(3)
  revokedAt     DateTime?   @db.Timestamptz(3)

  @@index([contributorId])
  @@index([expiresAt])
}

model Ingredient {
  id       String  @id @default(uuid())
  name     String
  amount   String?
  unit     String?
  quantity Float?  // derived from amount on write; NULL for ranges/words
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Direction {
  id          String @id @default(uuid())
  stepNumber  Int
  instruction String
  heading     String?
  recipeId    String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Tag {
  id      String   @id @default(uuid())
  name    String   @unique
  recipes Recipe[] @relation("RecipeTags")
}
